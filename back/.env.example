# Local development only. Never commit real secrets.
HCC_CIP_ENV=dev
HCC_CIP_DATABASE_URL=sqlite:///./hcc-cip.db
HCC_CIP_JWT_SECRET=dev-only-change-me-please-32-bytes-minimum-secret
HCC_CIP_ACCESS_TOKEN_MINUTES=480
HCC_CIP_AUTO_CREATE_TABLES=false
HCC_CIP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
HCC_CIP_LOGIN_MAX_FAILURES=5
HCC_CIP_LOGIN_WINDOW_SECONDS=300
