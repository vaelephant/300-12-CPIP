{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcc-cip.local/schemas/0.6.0/pathway_version.schema.json",
  "title": "pathway_version",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version_id",
    "template_id",
    "name",
    "disease_code",
    "version",
    "status",
    "graph",
    "rules",
    "content_hash",
    "created_by",
    "created_at",
    "validation"
  ],
  "properties": {
    "version_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "template_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "disease_code": {
      "const": "C22.0"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "enum": [
        "DRAFT",
        "IN_REVIEW",
        "PUBLISHED",
        "RETIRED"
      ]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_key",
              "type",
              "name",
              "stage",
              "required"
            ],
            "properties": {
              "node_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "type": {
                "enum": [
                  "START",
                  "END",
                  "ASSESSMENT",
                  "EXAMINATION",
                  "LAB_TEST",
                  "CONSULTATION",
                  "DECISION",
                  "SURGERY",
                  "TREATMENT",
                  "MEDICATION",
                  "NURSING",
                  "FOLLOW_UP"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "stage": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "required": {
                "type": "boolean"
              },
              "responsible_role": {
                "enum": [
                  "DOCTOR",
                  "SURGEON",
                  "NURSE",
                  "ANESTHESIOLOGIST",
                  "COORDINATOR"
                ]
              },
              "time_window": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "earliest_hour": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "latest_hour": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target",
              "kind"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "kind": {
                "enum": [
                  "SEQUENCE",
                  "CONDITIONAL",
                  "PARALLEL"
                ]
              },
              "condition": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "version",
          "binding"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "binding": {
            "enum": [
              "ADMISSION",
              "EXCLUSION",
              "BRANCH",
              "SAFETY",
              "COMPLETENESS"
            ]
          }
        }
      }
    },
    "content_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "approval": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reviewed_at",
        "comment"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errors",
        "warnings",
        "passed"
      ],
      "properties": {
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "boolean"
        }
      }
    }
  },
  "description": "Published versions are immutable; content_hash is the frozen graph hash."
}
